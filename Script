-- Auto Unbox AFK
-- Detecta caixas com ProximityPrompt e interage automaticamente

local RunService = game:GetService("RunService")
local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local rootPart = character:WaitForChild("HumanoidRootPart")

local COOLDOWN = 5 -- segundos entre cada unbox (ajuste se necessário)
local MAX_DISTANCE = 100 -- distância máxima pra detectar a caixa

local function findNearestBox()
    local nearestPrompt = nil
    local nearestDist = math.huge

    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") then
            local part = obj.Parent
            if part and part:IsA("BasePart") then
                local dist = (rootPart.Position - part.Position).Magnitude
                if dist < nearestDist and dist < MAX_DISTANCE then
                    nearestDist = dist
                    nearestPrompt = obj
                end
            end
        end
    end

    return nearestPrompt
end

while true do
    local prompt = findNearestBox()

    if prompt and not prompt.HoldPrompt then
        prompt:Trigger()
        wait(COOLDOWN)
    elseif prompt and prompt.HoldPrompt then
        prompt:Hold(0.5)
        wait(COOLDOWN)
    else
        wait(1) -- não achou caixa, tenta de novo
    end
end   
